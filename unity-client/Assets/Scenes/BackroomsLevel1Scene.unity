  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MyVirtualCommunity.Client.World.SecretContainmentArtifactDescriptor
  artifactId: clue:remanencia-hotel-maintenance-03
  titleEs: "Parte de Mantenimiento \u2014 Obra Norte"
  titleEn: "Maintenance Log \u2014 North Wing Works"
  loreEs: "Hoja de servicio fijada junto al tablero: 'Manchas gris\xE1ceas en juntas
    secas del concreto. Cortes el\xE9ctricos sin falla en l\xEDnea. Dos resanes anotados
    el d\xEDa 14 ya estaban hechos antes del da\xF1o; pasillo mide 1.4 m m\xE1s que
    en plano.'"
  loreEn: 'Service sheet fixed near the panel: ''Greyish stains along dry concrete
    joints. Power drops with no line fault. Two patches logged on the 14th appeared
    before the damage; corridor measures 1.4 m longer than drawn.'''
  accentColor: {r: 0.84, g: 0.76, b: 0.64, a: 1}
  inspectionScope: 0
