  m_Script: {fileID: 11500000, guid: b8fb68ed1ccdcce4c8e2cc7aa84dd778, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MyVirtualCommunity.Client.World.SecretContainmentArtifactDescriptor
  artifactId: clue:remanencia-hotel-cobalt-rumor-04
  titleEs: "Nota An\xF3nima \u2014 Rumor de Obra"
  titleEn: "Anonymous Note \u2014 Construction Rumor"
  loreEs: "Nota doblada a l\xE1piz sin firma: 'Dicen que parte de la varilla lleg\xF3
    contaminada. Algunos mencionan Cobalto-60, pero nadie ha mostrado pruebas. Lo
    extra\xF1o es que las manchas siguen apareciendo incluso donde ya se retir\xF3
    el material.'"
  loreEn: 'Unsigned folded pencil note: ''Word is some of the rebar arrived contaminated.
    A few mention Cobalt-60, though nobody has shown proof. The strange part is the
    stains keep returning even where the material was removed.'''
  accentColor: {r: 0.86, g: 0.74, b: 0.56, a: 1}
  inspectionScope: 0
