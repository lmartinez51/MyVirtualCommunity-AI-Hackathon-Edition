  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MyVirtualCommunity.Client.World.SecretContainmentArtifactDescriptor
  artifactId: artifact:telefono-negro
  titleEs: "El Tel\xE9fono Negro con Cable Cortado (EXP-11 \u2022 The Black Phone)"
  titleEn: "The Black Rotary Phone with Severed Cord (EXP-11 \u2022 The Black Phone)"
  loreEs: "Tel\xE9fono mural de baquelita montado en una columna amarilla del gran
    sal\xF3n. Su cable est\xE1 cortado, pero a veces timbra en el silencio de los
    pasillos."
  loreEn: Black Bakelite wall telephone mounted on a yellow column in the great pillared
    hall. Its cord is severed, yet it still rings in the silence.
  accentColor: {r: 0.75, g: 0.8, b: 0.9, a: 1}
