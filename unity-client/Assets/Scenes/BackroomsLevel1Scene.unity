  artifactId: artifact:atlas-geometria-anomala
  titleEs: "Atlas de Geometr\xEDa An\xF3mala"
  titleEn: Atlas of Anomalous Geometry
  loreEs: "Folio t\xE9cnico de gran formato colocado sobre un atril de acero junto
    a la b\xF3veda Nivel \u03A9. Contiene levantamientos topogr\xE1ficos de pasillos
    cerrados en bucle y \xE1ngulos imposibles."
  loreEn: "Oversized technical archival folio resting on a steel drafting stand beside
    the Level-\u03A9 vault. Its bound plates chart closed-loop corridors and non-Euclidean
    interior angles."
  accentColor: {r: 0.95, g: 0.68, b: 0.24, a: 1}
  inspectionScope: 0
