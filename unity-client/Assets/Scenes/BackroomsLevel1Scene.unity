  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::MyVirtualCommunity.Client.World.SecretContainmentArtifactDescriptor
  artifactId: artifact:nucleo-topologia-plegada
  titleEs: "N\xFAcleo de Topolog\xEDa Plegada"
  titleEn: Folded Topology Core
  loreEs: "Ensamble mec\xE1nico asim\xE9trico de placas cer\xE1micas y aluminio montado
    sobre una cuna de acero. Sus secciones escalonadas se desfasan entre s\xED como
    un modelo a escala de un espacio plegado."
  loreEn: Asymmetric mechanical assembly of stepped ceramic and aluminum plates seated
    in a steel cradle. Its offset tiers shift out of phase like a scale model of
    folded architectural space.
  accentColor: {r: 0.74, g: 0.86, b: 0.96, a: 1}
