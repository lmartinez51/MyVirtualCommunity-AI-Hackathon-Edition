  artifactId: artifact:lamina-trazado-coordenadas
  titleEs: "L\xE1mina de Trazado de Coordenadas"
  titleEn: Coordinate Plotting Plate
  loreEs: "Placa cartogr\xE1fica de pizarra y lat\xF3n con ret\xEDcula ortogonal
    y regla deslizable. Sus coordenadas trazan intersecciones bajo la Avenida Benito
    Ju\xE1rez que no figuran en los planos catastrales."
  loreEn: "Slate-and-brass cartographic plotting plate fitted with an orthogonal
    grid and sliding vernier rule. Its etched intersections map chambers beneath
    Avenida Benito Ju\xE1rez absent from civic surveys."
  accentColor: {r: 0.86, g: 0.72, b: 0.46, a: 1}
  inspectionScope: 0
