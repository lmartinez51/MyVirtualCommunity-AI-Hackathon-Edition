  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MyVirtualCommunity.Client.World.SecretContainmentArtifactDescriptor
  artifactId: artifact:intercomunicador-servicio
  titleEs: "Intercomunicador de Servicio sin L\xEDnea"
  titleEn: Unwired Service Intercom
  loreEs: "Caja de intercomunicaci\xF3n municipal fijada a la columna con el ducto
    el\xE9ctrico cortado. Aunque no existe tendido conectado, el altavoz emite breves
    chasquidos de portadora en los pasillos vac\xEDos."
  loreEn: Municipal-style wall intercom box bolted to the column with its conduit
    sheared off. Though no line is connected, the speaker emits brief carrier clicks
    across the empty halls.
  accentColor: {r: 0.75, g: 0.8, b: 0.9, a: 1}
  inspectionScope: 0
