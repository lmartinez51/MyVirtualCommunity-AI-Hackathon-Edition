  m_EditorClassIdentifier: Assembly-CSharp::MyVirtualCommunity.Client.World.SecretContainmentArtifactDescriptor
  artifactId: artifact:ensamble-madera-articulado
  titleEs: Ensamble de Madera Articulado
  titleEn: Articulated Wooden Assembly
  loreEs: "Estructura articulada de madera y pernos de lat\xF3n abandonada sobre
    una caja de archivo. Sus brazos m\xF3viles conservan marcas de calibraci\xF3n
    a l\xE1piz, aunque no corresponde a ning\xFAn instrumento convencional."
  loreEn: Hand-built jointed wooden frame with brass pivot pins left atop an archive
    crate. Its hinged arms bear pencil calibration marks, yet it matches no standard
    drafting or survey tool.
  accentColor: {r: 0.86, g: 0.68, b: 0.42, a: 1}
  inspectionScope: 0
