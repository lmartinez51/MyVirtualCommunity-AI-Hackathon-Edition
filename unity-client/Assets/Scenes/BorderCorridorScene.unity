  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::MyVirtualCommunity.Client.World.InteractionPoint
  category: 1
  characterId: elena-border-concierge
  characterName: Elena Ramos
  characterRole: Virtual Border Concierge
  avatar: "\U0001F6C2"
  suggestedPromptsEn:
  - What is the pedestrian wait time right now?
  - Is Paso del Norte faster than BOTA?
  - Where can I view live bridge cameras?
  suggestedPromptsEs:
  - "\xBFCu\xE1l es el tiempo de espera peatonal ahora?"
  - "\xBFPaso del Norte est\xE1 m\xE1s r\xE1pido que C\xF3rdova-Am\xE9ricas?"
  - "\xBFD\xF3nde puedo ver las c\xE1maras en vivo del puente?"
  landmarkId: infrastructure:puente-paso-del-norte
  title: Paso del Norte Border Information Point
  subtitle: "Border Concierge & Traveler Guidance \u2022 Elena Ramos"
  address: Puente Internacional Paso del Norte / Santa Fe (Port 240202)
  description: "Official international pedestrian crossing linking downtown Ciudad
    Ju\xE1rez with South El Paso Street in El Paso, Texas across the Rio Grande."
  backendFeatureNotice: 'Connected to Increment 3: Grounded Border Concierge (Elena
    Ramos) & Increment 1: Border Intelligence.

    Retrieves normalized CBP pedestrian
    wait times (General Lane), data freshness ratings, bridge comparisons (PDN vs
    BOTA), and official Chihuahua Bridge Authority camera portal links.'
  interactionRadius: 4.2
  promptText: "[E] Consult Border Concierge \xB7 Elena Ramos"
  highlightIndicator: {fileID: 0}
