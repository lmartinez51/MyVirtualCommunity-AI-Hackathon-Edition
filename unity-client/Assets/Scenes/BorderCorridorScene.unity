  characterName: Elena Ramos
  characterRole: Virtual Border Concierge
  avatar: "\U0001F6C2"
  activityState: available
  activityTitleEn: 
  activityTitleEs: 
  activityDescriptionEn: 
  activityDescriptionEs: 
