# ==============================================================================
# MyVirtualCommunity AI Hackathon Edition - Environment Configuration Example
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
# NEVER COMMIT .env OR REAL API KEYS TO VERSION CONTROL.
# ==============================================================================

# Meta Model API Configuration (Standardized on official MODEL_API_KEY)
# Required for live Meta Model API calls via scripts/meta-smoke-test.ts
MODEL_API_KEY=your_meta_model_api_key_here

# Base URL for Meta Model API (defaults to https://api.meta.ai/v1)
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Target Model Identifier (defaults to muse-spark-1.3)
MODEL_NAME=muse-spark-1.3

# Server Configuration
PORT=3000
HOST=127.0.0.1

# World Core HTTP Integration (Optional)
# If omitted or empty, the assistant server uses the in-memory development fixture.
# When provided, RemoteWorldCoreAdapter communicates with the live World Core server over HTTP.
# Example: http://127.0.0.1:3001
WORLD_CORE_BASE_URL=http://127.0.0.1:3001
