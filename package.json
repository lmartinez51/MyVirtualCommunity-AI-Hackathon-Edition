{
  "name": "my-virtual-community-ai-hackathon",
  "version": "0.1.0",
  "description": "MyVirtualCommunity AI Hackathon Edition - Meta AI-powered local-business assistant foundation",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node scripts/run-tests.js",
    "dev": "tsx src/server/index.ts",
    "demo": "powershell -ExecutionPolicy Bypass -File scripts/launch-demo.ps1",
    "package:release": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "test:meta-smoke": "tsx scripts/meta-smoke-test.ts",
    "test:integration": "tsx scripts/verify-world-core-integration.ts",
    "verify:live-assistant": "tsx scripts/verify-live-assistant.ts",
    "test:launcher": "powershell -ExecutionPolicy Bypass -File scripts/test-launcher-compatibility.ps1",
    "verify:npcs": "tsx scripts/verify-npc-dialogue.ts",
    "verify:recovery": "tsx scripts/verify-persistence-recovery.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "@types/sharp": "^0.32.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "sharp": "^0.35.5"
  }
}
